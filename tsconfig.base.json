{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ems/types": ["packages/types/src/index.ts"],
      "@ems/validation": ["packages/validation/src/index.ts"],
      "@ems/config": ["packages/config/src/index.ts"],
      "@ems/api-client": ["packages/api-client/src/index.ts"]
    }
  }
}
